# ---------------------------------------------------------------- MedicCare backend environment
# Copy this file to `.env` and adjust the values. Never commit `.env`.

# HTTP
NODE_ENV=development
PORT=4000
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4300

# Apache Jena Fuseki (docker compose up -d)
FUSEKI_BASE_URL=http://localhost:3030
FUSEKI_DATASET=medicare
FUSEKI_QUERY_PATH=/query
FUSEKI_UPDATE_PATH=/update
FUSEKI_USER=admin
FUSEKI_PASSWORD=medicare
FUSEKI_QUERY_TIMEOUT_MS=15000
FUSEKI_SPARQL_LIMIT_CAP=5000

# Auth
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=10
# Used only when npm run seed creates new demo accounts. Set a private value.
SEED_DEMO_PASSWORD=change-this-before-seeding

# SQLite (users, refresh tokens, audit log)
SQLITE_FILE=./data/app.db

# NLP micro-service
NLP_SERVICE_URL=http://localhost:8100
NLP_TIMEOUT_MS=20000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# Logging
LOG_LEVEL=info
