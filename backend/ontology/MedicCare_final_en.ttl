@prefix : <http://www.semanticweb.org/kmarb/ontologies/2026/8/medical-care-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@base <http://www.semanticweb.org/kmarb/ontologies/2026/8/medical-care-ontology> .

<http://www.semanticweb.org/kmarb/ontologies/2026/8/medical-care-ontology> rdf:type owl:Ontology ;
    dc:title "Medical Care Ontology"@en ;
    dc:creator "Zeineb Ghezaiel, Kmar Ben Mbarek, Abir Ben Brahem, Oussema Bani, Jacem Guesmi" ;
    rdfs:comment "Ontology modelling medical care: patients, doctors, diseases, symptoms, treatments, medications, tests, hospitals, appointments and departments."@en ;
    owl:versionInfo "2.0" .

# ================= ANNOTATION PROPERTIES =================
skos:altLabel rdf:type owl:AnnotationProperty .
dc:title rdf:type owl:AnnotationProperty .
dc:creator rdf:type owl:AnnotationProperty .

# ================= OBJECT PROPERTIES =================
:hasDisease rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :Patient ; rdfs:range :Disease ; owl:inverseOf :isDiseaseOf ;
    rdfs:label "has disease"@en .
:isDiseaseOf rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :Disease ; rdfs:range :Patient ;
    rdfs:label "is disease of"@en .

:treatedBy rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :Patient ; rdfs:range :Doctor ; owl:inverseOf :treats ;
    rdfs:label "treated by"@en .
:treats rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :Doctor ; rdfs:range :Patient ;
    rdfs:label "treats"@en .

:hasSymptom rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :Disease ; rdfs:range :Symptom ; owl:inverseOf :isSymptomOf ;
    rdfs:label "has symptom"@en .
:isSymptomOf rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :Symptom ; rdfs:range :Disease ;
    rdfs:label "is symptom of"@en .

:hasTreatment rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :Disease ; rdfs:range :Treatment ; owl:inverseOf :isTreatmentOf ;
    rdfs:label "has treatment"@en .
:isTreatmentOf rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :Treatment ; rdfs:range :Disease ;
    rdfs:label "is treatment of"@en .

:usesMedication rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :Treatment ; rdfs:range :Medication ; owl:inverseOf :isUsedIn ;
    rdfs:label "uses medication"@en .
:isUsedIn rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :Medication ; rdfs:range :Treatment ;
    rdfs:label "is used in"@en .

:undergoesTest rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :Patient ; rdfs:range :MedicalTest ; owl:inverseOf :isTestOf ;
    rdfs:label "undergoes test"@en .
:isTestOf rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :MedicalTest ; rdfs:range :Patient ;
    rdfs:label "is test of"@en .

:hasAppointment rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :Patient ; rdfs:range :MedicalAppointment ; owl:inverseOf :appointmentOf ;
    rdfs:label "has appointment"@en .
:appointmentOf rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :MedicalAppointment ; rdfs:range :Patient ;
    rdfs:label "appointment of"@en .

:worksIn rdf:type owl:ObjectProperty, owl:IrreflexiveProperty, owl:FunctionalProperty ;
    rdfs:domain :Doctor ; rdfs:range :MedicalDepartment ; owl:inverseOf :hasDoctor ;
    rdfs:label "works in"@en .
:hasDoctor rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :MedicalDepartment ; rdfs:range :Doctor ;
    rdfs:label "has doctor"@en .

:locatedIn rdf:type owl:ObjectProperty, owl:IrreflexiveProperty, owl:FunctionalProperty ;
    rdfs:domain :MedicalDepartment ; rdfs:range :Hospital ; owl:inverseOf :hasDepartment ;
    rdfs:label "located in"@en .
:hasDepartment rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :Hospital ; rdfs:range :MedicalDepartment ;
    rdfs:label "has department"@en .

:belongsToDepartment rdf:type owl:ObjectProperty, owl:IrreflexiveProperty, owl:FunctionalProperty ;
    rdfs:domain :MedicalAppointment ; rdfs:range :MedicalDepartment ; owl:inverseOf :includesAppointment ;
    rdfs:label "belongs to department"@en .
:includesAppointment rdf:type owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:domain :MedicalDepartment ; rdfs:range :MedicalAppointment ;
    rdfs:label "includes appointment"@en .

:followedInDepartment rdf:type owl:ObjectProperty ;
    rdfs:domain :Patient ; rdfs:range :MedicalDepartment ;
    owl:propertyChainAxiom ( :treatedBy :worksIn ) ;
    rdfs:label "followed in department"@en .

:followedInHospital rdf:type owl:ObjectProperty ;
    rdfs:domain :Patient ; rdfs:range :Hospital ;
    owl:propertyChainAxiom ( :followedInDepartment :locatedIn ) ;
    rdfs:label "followed in hospital"@en .

# ================= DATA PROPERTIES =================
:hasName rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Patient ; rdfs:range xsd:string ; rdfs:label "has name"@en .
:hasAge rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Patient ; rdfs:range xsd:integer ; rdfs:label "has age"@en .
:hasGender rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Patient ; rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "Male" "Female" ) ] ; rdfs:label "has gender"@en .
:hasBloodType rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Patient ; rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "A+" "A-" "B+" "B-" "AB+" "AB-" "O+" "O-" ) ] ; rdfs:label "has blood type"@en .
:hasPhoneNumber rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Patient ; rdfs:range xsd:string ; rdfs:label "has phone number"@en .
:doctorName rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Doctor ; rdfs:range xsd:string ; rdfs:label "doctor name"@en .
:doctorLicenseNumber rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Doctor ; rdfs:range xsd:string ; rdfs:label "doctor license number"@en .
:diseaseName rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Disease ; rdfs:range xsd:string ; rdfs:label "disease name"@en .
:diseaseDescription rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Disease ; rdfs:range xsd:string ; rdfs:label "disease description"@en .
:testResult rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :MedicalTest ; rdfs:range xsd:string ; rdfs:label "test result"@en .
:testDate rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :MedicalTest ; rdfs:range xsd:dateTime ; rdfs:label "test date"@en .
:appointmentDate rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :MedicalAppointment ; rdfs:range xsd:dateTime ; rdfs:label "appointment date"@en .
:appointmentStatus rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :MedicalAppointment ; rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "Pending" "Confirmed" "Completed" "Cancelled" ) ] ; rdfs:label "appointment status"@en .
:hospitalName rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Hospital ; rdfs:range xsd:string ; rdfs:label "hospital name"@en .
:medicationDosage rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Medication ; rdfs:range xsd:string ; rdfs:label "medication dosage"@en .
:symptomName rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Symptom ; rdfs:range xsd:string ; rdfs:label "symptom name"@en .
:treatmentName rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Treatment ; rdfs:range xsd:string ; rdfs:label "treatment name"@en .
:treatmentDuration rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Treatment ; rdfs:range xsd:string ; rdfs:label "treatment duration"@en .
:medicationName rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Medication ; rdfs:range xsd:string ; rdfs:label "medication name"@en .
:departmentName rdf:type owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :MedicalDepartment ; rdfs:range xsd:string ; rdfs:label "department name"@en .

# ================= CLASSES =================
:Patient rdf:type owl:Class ;
    rdfs:label "Patient"@en .
:Doctor rdf:type owl:Class ;
    rdfs:label "Doctor"@en .
:Disease rdf:type owl:Class ;
    rdfs:label "Disease"@en .
:Symptom rdf:type owl:Class ;
    rdfs:label "Symptom"@en .
:Treatment rdf:type owl:Class ;
    rdfs:label "Treatment"@en .
:Medication rdf:type owl:Class ;
    rdfs:label "Medication"@en .
:MedicalTest rdf:type owl:Class ;
    rdfs:label "Medical Test"@en .
:Hospital rdf:type owl:Class ;
    rdfs:label "Hospital"@en .
:MedicalAppointment rdf:type owl:Class ;
    rdfs:label "Medical Appointment"@en .
:MedicalDepartment rdf:type owl:Class ;
    rdfs:label "Medical Department"@en .
:AdultPatient rdf:type owl:Class ;
    rdfs:subClassOf :Patient ;
    rdfs:label "Adult Patient"@en .
:ChildPatient rdf:type owl:Class ;
    rdfs:subClassOf :Patient ;
    rdfs:label "Child Patient"@en .
:ElderlyPatient rdf:type owl:Class ;
    rdfs:subClassOf :Patient ;
    rdfs:label "Elderly Patient"@en .
:GeneralPractitioner rdf:type owl:Class ;
    rdfs:subClassOf :Doctor ;
    rdfs:label "General Practitioner"@en .
:EmergencyPhysician rdf:type owl:Class ;
    rdfs:subClassOf :Doctor ;
    rdfs:label "Emergency Physician"@en .
:Cardiologist rdf:type owl:Class ;
    rdfs:subClassOf :Doctor ;
    rdfs:label "Cardiologist"@en .
:Dermatologist rdf:type owl:Class ;
    rdfs:subClassOf :Doctor ;
    rdfs:label "Dermatologist"@en .
:Neurologist rdf:type owl:Class ;
    rdfs:subClassOf :Doctor ;
    rdfs:label "Neurologist"@en .
:InfectiousDisease rdf:type owl:Class ;
    rdfs:subClassOf :Disease ;
    rdfs:label "Infectious Disease"@en .
:ChronicDisease rdf:type owl:Class ;
    rdfs:subClassOf :Disease ;
    rdfs:label "Chronic Disease"@en .
:CardiovascularDisease rdf:type owl:Class ;
    rdfs:subClassOf :Disease ;
    rdfs:label "Cardiovascular Disease"@en .
:RespiratoryDisease rdf:type owl:Class ;
    rdfs:subClassOf :Disease ;
    rdfs:label "Respiratory Disease"@en .
:Fever rdf:type owl:Class ;
    rdfs:subClassOf :Symptom ;
    rdfs:label "Fever"@en .
:Headache rdf:type owl:Class ;
    rdfs:subClassOf :Symptom ;
    rdfs:label "Headache"@en .
:Cough rdf:type owl:Class ;
    rdfs:subClassOf :Symptom ;
    rdfs:label "Cough"@en .
:Fatigue rdf:type owl:Class ;
    rdfs:subClassOf :Symptom ;
    rdfs:label "Fatigue"@en .
:ChestPain rdf:type owl:Class ;
    rdfs:subClassOf :Symptom ;
    rdfs:label "Chest Pain"@en .
:SkinRash rdf:type owl:Class ;
    rdfs:subClassOf :Symptom ;
    rdfs:label "Skin Rash"@en .
:MedicationTreatment rdf:type owl:Class ;
    rdfs:subClassOf :Treatment ;
    rdfs:label "Medication Treatment"@en .
:SurgicalTreatment rdf:type owl:Class ;
    rdfs:subClassOf :Treatment ;
    rdfs:label "Surgical Treatment"@en .
:Physiotherapy rdf:type owl:Class ;
    rdfs:subClassOf :Treatment ;
    rdfs:label "Physiotherapy"@en .
:Antibiotic rdf:type owl:Class ;
    rdfs:subClassOf :Medication ;
    rdfs:label "Antibiotic"@en .
:Analgesic rdf:type owl:Class ;
    rdfs:subClassOf :Medication ;
    rdfs:label "Analgesic"@en .
:Antiviral rdf:type owl:Class ;
    rdfs:subClassOf :Medication ;
    rdfs:label "Antiviral"@en .
:Antihypertensive rdf:type owl:Class ;
    rdfs:subClassOf :Medication ;
    rdfs:label "Antihypertensive"@en .
:Antidiabetic rdf:type owl:Class ;
    rdfs:subClassOf :Medication ;
    rdfs:label "Antidiabetic"@en .
:BloodTest rdf:type owl:Class ;
    rdfs:subClassOf :MedicalTest ;
    rdfs:label "Blood Test"@en .
:UrineTest rdf:type owl:Class ;
    rdfs:subClassOf :MedicalTest ;
    rdfs:label "Urine Test"@en .
:XRay rdf:type owl:Class ;
    rdfs:subClassOf :MedicalTest ;
    rdfs:label "X-Ray"@en .
:MRI rdf:type owl:Class ;
    rdfs:subClassOf :MedicalTest ;
    rdfs:label "MRI"@en .
:CTScan rdf:type owl:Class ;
    rdfs:subClassOf :MedicalTest ;
    rdfs:label "CT Scan"@en .
:PublicHospital rdf:type owl:Class ;
    rdfs:subClassOf :Hospital ;
    rdfs:label "Public Hospital"@en .
:PrivateHospital rdf:type owl:Class ;
    rdfs:subClassOf :Hospital ;
    rdfs:label "Private Hospital"@en .
:UniversityHospital rdf:type owl:Class ;
    rdfs:subClassOf :Hospital ;
    rdfs:label "University Hospital"@en .
:Consultation rdf:type owl:Class ;
    rdfs:subClassOf :MedicalAppointment ;
    rdfs:label "Consultation"@en .
:FollowUpAppointment rdf:type owl:Class ;
    rdfs:subClassOf :MedicalAppointment ;
    rdfs:label "Follow Up Appointment"@en .
:EmergencyAppointment rdf:type owl:Class ;
    rdfs:subClassOf :MedicalAppointment ;
    rdfs:label "Emergency Appointment"@en .
:CardiologyDepartment rdf:type owl:Class ;
    rdfs:subClassOf :MedicalDepartment ;
    rdfs:label "Cardiology Department"@en .
:DermatologyDepartment rdf:type owl:Class ;
    rdfs:subClassOf :MedicalDepartment ;
    rdfs:label "Dermatology Department"@en .
:NeurologyDepartment rdf:type owl:Class ;
    rdfs:subClassOf :MedicalDepartment ;
    rdfs:label "Neurology Department"@en .
:EmergencyDepartment rdf:type owl:Class ;
    rdfs:subClassOf :MedicalDepartment ;
    rdfs:label "Emergency Department"@en .
:GeneralMedicineDepartment rdf:type owl:Class ;
    rdfs:subClassOf :MedicalDepartment ;
    rdfs:label "General Medicine Department"@en .
:ChronicPatient rdf:type owl:Class ;
    rdfs:subClassOf :Patient ;
    rdfs:label "Chronic Patient"@en .
:EmergencyPatient rdf:type owl:Class ;
    rdfs:subClassOf :Patient ;
    rdfs:label "Emergency Patient"@en .

# ================= DISJOINTNESS =================
[ rdf:type owl:AllDisjointClasses ; owl:members ( :Patient :Doctor :Disease :Symptom :Treatment :Medication :MedicalTest :Hospital :MedicalAppointment :MedicalDepartment ) ] .
[ rdf:type owl:AllDisjointClasses ; owl:members ( :AdultPatient :ChildPatient :ElderlyPatient ) ] .
[ rdf:type owl:AllDisjointClasses ; owl:members ( :GeneralPractitioner :EmergencyPhysician :Cardiologist :Dermatologist :Neurologist ) ] .
[ rdf:type owl:AllDisjointClasses ; owl:members ( :Fever :Headache :Cough :Fatigue :ChestPain :SkinRash ) ] .
[ rdf:type owl:AllDisjointClasses ; owl:members ( :MedicationTreatment :SurgicalTreatment :Physiotherapy ) ] .
[ rdf:type owl:AllDisjointClasses ; owl:members ( :Antibiotic :Analgesic :Antiviral :Antihypertensive :Antidiabetic ) ] .
[ rdf:type owl:AllDisjointClasses ; owl:members ( :BloodTest :UrineTest :XRay :MRI :CTScan ) ] .
[ rdf:type owl:AllDisjointClasses ; owl:members ( :PublicHospital :PrivateHospital :UniversityHospital ) ] .
[ rdf:type owl:AllDisjointClasses ; owl:members ( :Consultation :FollowUpAppointment :EmergencyAppointment ) ] .
[ rdf:type owl:AllDisjointClasses ; owl:members ( :CardiologyDepartment :DermatologyDepartment :NeurologyDepartment :EmergencyDepartment :GeneralMedicineDepartment ) ] .

# ================= RESTRICTIONS (SubClassOf) =================
:Patient rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :treatedBy ; owl:someValuesFrom :Doctor ] .
:Patient rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasDisease ; owl:someValuesFrom :Disease ] .
:Patient rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasName ; owl:someValuesFrom xsd:string ] .
:Patient rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasAge ; owl:someValuesFrom xsd:integer ] .
:Doctor rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :worksIn ; owl:qualifiedCardinality 1 ; owl:onClass :MedicalDepartment ] .
:Doctor rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :doctorName ; owl:someValuesFrom xsd:string ] .
:Doctor rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :doctorLicenseNumber ; owl:someValuesFrom xsd:string ] .
:MedicalDepartment rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :locatedIn ; owl:qualifiedCardinality 1 ; owl:onClass :Hospital ] .
:MedicalAppointment rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :belongsToDepartment ; owl:qualifiedCardinality 1 ; owl:onClass :MedicalDepartment ] .
:MedicalAppointment rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :appointmentDate ; owl:someValuesFrom xsd:dateTime ] .
:Disease rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasSymptom ; owl:someValuesFrom :Symptom ] .
:Disease rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :hasTreatment ; owl:someValuesFrom :Treatment ] .
:MedicationTreatment rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :usesMedication ; owl:someValuesFrom :Medication ] .
:Cardiologist rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :worksIn ; owl:someValuesFrom :CardiologyDepartment ] .
:Dermatologist rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :worksIn ; owl:someValuesFrom :DermatologyDepartment ] .
:Neurologist rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :worksIn ; owl:someValuesFrom :NeurologyDepartment ] .
:EmergencyPhysician rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :worksIn ; owl:someValuesFrom :EmergencyDepartment ] .
:GeneralPractitioner rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :worksIn ; owl:someValuesFrom :GeneralMedicineDepartment ] .
:EmergencyAppointment rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty :belongsToDepartment ; owl:someValuesFrom :EmergencyDepartment ] .

# ================= CLASSES DEFINIES (EquivalentTo) =================
:ChildPatient owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( :Patient [ rdf:type owl:Restriction ; owl:onProperty :hasAge ; owl:someValuesFrom [ rdf:type rdfs:Datatype ; owl:onDatatype xsd:integer ; owl:withRestrictions ( [ xsd:maxExclusive 18 ] ) ] ] ) ] .
:AdultPatient owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( :Patient [ rdf:type owl:Restriction ; owl:onProperty :hasAge ; owl:someValuesFrom [ rdf:type rdfs:Datatype ; owl:onDatatype xsd:integer ; owl:withRestrictions ( [ xsd:minInclusive 18 ] [ xsd:maxExclusive 65 ] ) ] ] ) ] .
:ElderlyPatient owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( :Patient [ rdf:type owl:Restriction ; owl:onProperty :hasAge ; owl:someValuesFrom [ rdf:type rdfs:Datatype ; owl:onDatatype xsd:integer ; owl:withRestrictions ( [ xsd:minInclusive 65 ] ) ] ] ) ] .
:ChronicPatient owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( :Patient [ rdf:type owl:Restriction ; owl:onProperty :hasDisease ; owl:someValuesFrom :ChronicDisease ] ) ] .
:EmergencyPatient owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( :Patient [ rdf:type owl:Restriction ; owl:onProperty :hasAppointment ; owl:someValuesFrom :EmergencyAppointment ] ) ] .
:Doctor owl:hasKey ( :doctorLicenseNumber ) .
:Hospital owl:hasKey ( :hospitalName ) .

# ================= INDIVIDUALS =================
:Fever_01 rdf:type owl:NamedIndividual, :Fever ;
    :isSymptomOf :Influenza , :Appendicitis , :Pneumonia ;
    :symptomName "Fever" ;
    rdfs:label "Fever"@en ;
    skos:altLabel "high temperature"@en .
:Headache_01 rdf:type owl:NamedIndividual, :Headache ;
    :isSymptomOf :Diabetes , :Hypertension , :Influenza , :Migraine ;
    :symptomName "Headache" ;
    rdfs:label "Headache"@en ;
    skos:altLabel "head pain"@en .
:Cough_01 rdf:type owl:NamedIndividual, :Cough ;
    :isSymptomOf :Influenza , :Asthma , :Pneumonia ;
    :symptomName "Cough" ;
    rdfs:label "Cough"@en .
:Fatigue_01 rdf:type owl:NamedIndividual, :Fatigue ;
    :isSymptomOf :Diabetes , :Hypertension , :Asthma ;
    :symptomName "Fatigue" ;
    rdfs:label "Fatigue"@en ;
    skos:altLabel "tiredness"@en .
:ChestPain_01 rdf:type owl:NamedIndividual, :ChestPain ;
    :isSymptomOf :Hypertension , :Pneumonia ;
    :symptomName "Chest pain" ;
    rdfs:label "Chest Pain"@en ;
    skos:altLabel "chest discomfort"@en .
:SkinRash_01 rdf:type owl:NamedIndividual, :SkinRash ;
    :isSymptomOf :Eczema ;
    :symptomName "Skin rash" ;
    rdfs:label "Skin Rash"@en ;
    skos:altLabel "itching"@en ;
    skos:altLabel "redness"@en .
:Diabetes rdf:type owl:NamedIndividual, :ChronicDisease ;
    :hasSymptom :Fatigue_01 , :Headache_01 ;
    :hasTreatment :DiabetesTreatment ;
    :isDiseaseOf :Patient_Ahmed , :Patient_Nour ;
    :diseaseName "Diabetes" ;
    :diseaseDescription "Chronic metabolic disease" ;
    rdfs:label "Diabetes"@en ;
    skos:altLabel "diabetes mellitus"@en .
:Hypertension rdf:type owl:NamedIndividual, :CardiovascularDisease, :ChronicDisease ;
    :hasSymptom :ChestPain_01 , :Fatigue_01 , :Headache_01 ;
    :hasTreatment :HypertensionTreatment ;
    :isDiseaseOf :Patient_Mariam , :Patient_Karim ;
    :diseaseName "Hypertension" ;
    :diseaseDescription "High blood pressure condition" ;
    rdfs:label "Hypertension"@en ;
    skos:altLabel "high blood pressure"@en .
:Influenza rdf:type owl:NamedIndividual, :InfectiousDisease ;
    :hasSymptom :Cough_01 , :Fever_01 , :Headache_01 ;
    :hasTreatment :InfluenzaTreatment ;
    :isDiseaseOf :Patient_Sara ;
    :diseaseName "Influenza" ;
    :diseaseDescription "Viral respiratory infection" ;
    rdfs:label "Influenza"@en ;
    skos:altLabel "flu"@en .
:Asthma rdf:type owl:NamedIndividual, :RespiratoryDisease, :ChronicDisease ;
    :hasSymptom :Cough_01 , :Fatigue_01 ;
    :hasTreatment :RespiratoryPhysiotherapy ;
    :isDiseaseOf :Patient_Youssef ;
    :diseaseName "Asthma" ;
    :diseaseDescription "Chronic respiratory condition" ;
    rdfs:label "Asthma"@en .
:Appendicitis rdf:type owl:NamedIndividual, :InfectiousDisease ;
    :hasSymptom :Fever_01 ;
    :hasTreatment :AppendectomySurgery ;
    :isDiseaseOf :Patient_Hichem ;
