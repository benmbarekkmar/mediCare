:Cardiologist a owl:Class ;
    rdfs:label "Cardiologist"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :worksIn ;
            owl:someValuesFrom :CardiologyDepartment ],
        :Doctor .

:ChestPain_01 a :ChestPain,
        :Symptom,
        owl:NamedIndividual ;
    rdfs:label "Chest Pain"@en ;
    :isSymptomOf :Hypertension,
        :Pneumonia ;
    :symptomName "Chest pain" ;
    skos:altLabel "chest discomfort"@en .

:ChildPatient a owl:Class ;
    rdfs:label "Child Patient"@en ;
    rdfs:subClassOf :Patient ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Patient [ a owl:Restriction ;
                        owl:onProperty :hasAge ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 18 ] ) ] ] ) ] .

:DermatologyDepartment a owl:Class ;
    rdfs:label "Dermatology Department"@en ;
    rdfs:subClassOf :MedicalDepartment .

