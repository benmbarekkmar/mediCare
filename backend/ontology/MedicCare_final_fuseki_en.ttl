:Hospital a owl:Class ;
    rdfs:label "Hospital"@en ;
    owl:hasKey ( :hospitalName ) .

:Symptom a owl:Class ;
    rdfs:label "Symptom"@en .

:Treatment a owl:Class ;
    rdfs:label "Treatment"@en .

:MedicalAppointment a owl:Class ;
    rdfs:label "Medical Appointment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :MedicalDepartment ;
            owl:onProperty :belongsToDepartment ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onProperty :appointmentDate ;
            owl:someValuesFrom xsd:dateTime ] .

:Doctor a owl:Class ;
    rdfs:label "Doctor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :MedicalDepartment ;
            owl:onProperty :worksIn ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onProperty :doctorName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty :doctorLicenseNumber ;
            owl:someValuesFrom xsd:string ] ;
    owl:hasKey ( :doctorLicenseNumber ) .

:MedicalTest a owl:Class ;
    rdfs:label "Medical Test"@en .

:Medication a owl:Class ;
    rdfs:label "Medication"@en .

:Disease a owl:Class ;
    rdfs:label "Disease"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasSymptom ;
            owl:someValuesFrom :Symptom ],
        [ a owl:Restriction ;
            owl:onProperty :hasTreatment ;
            owl:someValuesFrom :Treatment ] .

:MedicalDepartment a owl:Class ;
    rdfs:label "Medical Department"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Hospital ;
            owl:onProperty :locatedIn ;
            owl:qualifiedCardinality 1 ] .

:Patient a owl:Class ;
    rdfs:label "Patient"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :treatedBy ;
            owl:someValuesFrom :Doctor ],
        [ a owl:Restriction ;
            owl:onProperty :hasDisease ;
            owl:someValuesFrom :Disease ],
        [ a owl:Restriction ;
            owl:onProperty :hasName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty :hasAge ;
            owl:someValuesFrom xsd:integer ] .

