@prefix : <http://www.semanticweb.org/kmarb/ontologies/2026/8/medical-care-ontology#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:creator a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

<http://www.semanticweb.org/kmarb/ontologies/2026/8/medical-care-ontology> a owl:Ontology ;
    dc:creator "Zeineb Ghezaiel, Kmar Ben Mbarek, Abir Ben Brahem, Oussema Bani, Jacem Guesmi" ;
    dc:title "Medical Care Ontology"@en ;
    rdfs:comment "Ontology modelling medical care: patients, doctors, diseases, symptoms, treatments, medications, tests, hospitals, appointments and departments."@en ;
    owl:versionInfo "2.0" .

:appointmentStatus a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "appointment status"@en ;
    rdfs:domain :MedicalAppointment ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "Pending" "Confirmed" "Completed" "Cancelled" ) ] .

:departmentName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "department name"@en ;
    rdfs:domain :MedicalDepartment ;
    rdfs:range xsd:string .

:diseaseDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "disease description"@en ;
    rdfs:domain :Disease ;
    rdfs:range xsd:string .

:diseaseName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "disease name"@en ;
    rdfs:domain :Disease ;
    rdfs:range xsd:string .

:followedInHospital a owl:ObjectProperty ;
    rdfs:label "followed in hospital"@en ;
    rdfs:domain :Patient ;
    rdfs:range :Hospital ;
    owl:propertyChainAxiom ( :followedInDepartment :locatedIn ) .

:hasBloodType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has blood type"@en ;
    rdfs:domain :Patient ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "A+" "A-" "B+" "B-" "AB+" "AB-" "O+" "O-" ) ] .

:hasGender a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has gender"@en ;
    rdfs:domain :Patient ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "Male" "Female" ) ] .

:hasPhoneNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has phone number"@en ;
    rdfs:domain :Patient ;
    rdfs:range xsd:string .

:medicationDosage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "medication dosage"@en ;
    rdfs:domain :Medication ;
    rdfs:range xsd:string .

:medicationName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "medication name"@en ;
    rdfs:domain :Medication ;
    rdfs:range xsd:string .

:symptomName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "symptom name"@en ;
    rdfs:domain :Symptom ;
    rdfs:range xsd:string .

:testDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "test date"@en ;
    rdfs:domain :MedicalTest ;
    rdfs:range xsd:dateTime .

:testResult a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "test result"@en ;
    rdfs:domain :MedicalTest ;
    rdfs:range xsd:string .

:treatmentDuration a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "treatment duration"@en ;
    rdfs:domain :Treatment ;
    rdfs:range xsd:string .

:treatmentName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "treatment name"@en ;
    rdfs:domain :Treatment ;
    rdfs:range xsd:string .

:undergoesTest a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "undergoes test"@en ;
    rdfs:domain :Patient ;
    rdfs:range :MedicalTest ;
    owl:inverseOf :isTestOf .

skos:altLabel a owl:AnnotationProperty .

:CardiovascularDisease a owl:Class ;
    rdfs:label "Cardiovascular Disease"@en ;
    rdfs:subClassOf :Disease .

:appointmentDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "appointment date"@en ;
    rdfs:domain :MedicalAppointment ;
    rdfs:range xsd:dateTime .

:appointmentOf a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "appointment of"@en ;
    rdfs:domain :MedicalAppointment ;
    rdfs:range :Patient .

:doctorName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "doctor name"@en ;
    rdfs:domain :Doctor ;
    rdfs:range xsd:string .

:followedInDepartment a owl:ObjectProperty ;
    rdfs:label "followed in department"@en ;
    rdfs:domain :Patient ;
    rdfs:range :MedicalDepartment ;
    owl:propertyChainAxiom ( :treatedBy :worksIn ) .

:hasAppointment a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has appointment"@en ;
    rdfs:domain :Patient ;
    rdfs:range :MedicalAppointment ;
    owl:inverseOf :appointmentOf .

:hasDepartment a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has department"@en ;
    rdfs:domain :Hospital ;
    rdfs:range :MedicalDepartment .

:hasDoctor a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has doctor"@en ;
    rdfs:domain :MedicalDepartment ;
    rdfs:range :Doctor .

:hasName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has name"@en ;
    rdfs:domain :Patient ;
    rdfs:range xsd:string .

:hasSymptom a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has symptom"@en ;
    rdfs:domain :Disease ;
    rdfs:range :Symptom ;
    owl:inverseOf :isSymptomOf .

:hasTreatment a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has treatment"@en ;
    rdfs:domain :Disease ;
    rdfs:range :Treatment ;
    owl:inverseOf :isTreatmentOf .

:hospitalName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "hospital name"@en ;
    rdfs:domain :Hospital ;
    rdfs:range xsd:string .

:includesAppointment a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "includes appointment"@en ;
    rdfs:domain :MedicalDepartment ;
    rdfs:range :MedicalAppointment .

:isDiseaseOf a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "is disease of"@en ;
    rdfs:domain :Disease ;
    rdfs:range :Patient .

:isSymptomOf a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "is symptom of"@en ;
    rdfs:domain :Symptom ;
    rdfs:range :Disease .

:isTestOf a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "is test of"@en ;
    rdfs:domain :MedicalTest ;
    rdfs:range :Patient .

:isTreatmentOf a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "is treatment of"@en ;
    rdfs:domain :Treatment ;
    rdfs:range :Disease .

:isUsedIn a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "is used in"@en ;
    rdfs:domain :Medication ;
    rdfs:range :Treatment .

:treats a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "treats"@en ;
    rdfs:domain :Doctor ;
    rdfs:range :Patient .

:usesMedication a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "uses medication"@en ;
    rdfs:domain :Treatment ;
    rdfs:range :Medication ;
    owl:inverseOf :isUsedIn .

