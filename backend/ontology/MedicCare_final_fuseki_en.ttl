:belongsToDepartment a owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "belongs to department"@en ;
    rdfs:domain :MedicalAppointment ;
    rdfs:range :MedicalDepartment ;
    owl:inverseOf :includesAppointment .

:doctorLicenseNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "doctor license number"@en ;
    rdfs:domain :Doctor ;
    rdfs:range xsd:string .

:hasDisease a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has disease"@en ;
    rdfs:domain :Patient ;
    rdfs:range :Disease ;
    owl:inverseOf :isDiseaseOf .

:locatedIn a owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "located in"@en ;
    rdfs:domain :MedicalDepartment ;
    rdfs:range :Hospital ;
    owl:inverseOf :hasDepartment .

:treatedBy a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "treated by"@en ;
    rdfs:domain :Patient ;
    rdfs:range :Doctor ;
    owl:inverseOf :treats .

